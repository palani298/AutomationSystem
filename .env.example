# LLM — required for a live discovery run
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Control plane
APP_HOST=127.0.0.1
APP_PORT=8787
DATABASE_PATH=data/registry.sqlite
EVIDENCE_DIR=evidence
ALLOWLIST_HOSTS=127.0.0.1,localhost

# Browser
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO_MS=80

# Temporal (start with: temporal server start-dev)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=capability-forge

# Optional: Slack/ticket URL for admins who do not have the UI open.
# An open console uses /ws/admin (connects on page load, gone on tab close).
# APPROVAL_WEBHOOK_URL=https://hooks.slack.com/services/...
